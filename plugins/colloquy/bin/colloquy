#!/bin/sh
# The one entry point. Claude Code appends every enabled plugin's bin/ to PATH;
# Codex resolves this launcher from the active skill directory.
#
# Two subcommands open a browser: `version check --render` looks at the page and
# `version export` copies it. Both need Playwright, and declaring it in the script's
# PEP 723 header would put its wheel behind every `server run`, `review wait`, and
# `version publish`, so it is supplied here on exactly the invocations that launch
# Chrome.
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
script=$root/skills/colloquy/scripts/interact.py

# Codex exposes the thread id to shell tools. Carry it and the long-lived Codex
# process into the same session record Claude Code supplies directly.
if [ -z "${CLAUDE_CODE_SESSION_ID:-}" ] && [ -n "${CODEX_THREAD_ID:-}" ]; then
  export COLLOQUY_SESSION_ID=$CODEX_THREAD_ID
  export COLLOQUY_SESSION_PID=$PPID
  export COLLOQUY_AGENT=Codex
fi

if [ "${1-}" = "version" ] && [ "${2-}" = "export" ]; then
  exec uv run --with playwright "$script" "$@"
fi

if [ "${1-}" = "version" ] && [ "${2-}" = "check" ]; then
  for cli_arg in "$@"; do
    if [ "$cli_arg" = "--render" ]; then
      exec uv run --with playwright "$script" "$@"
    fi
  done
fi
exec uv run "$script" "$@"
